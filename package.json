{
  "name": "elections",
  "version": "0.1.0",
  "private": true,
  "description": "Nate Silver-style election forecasting model running on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "deploy": "npm run build:web && wrangler deploy",
    "db:init": "wrangler d1 execute elections --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute elections --remote --file=./schema.sql",
    "ratings": "node scripts/build-pollster-ratings.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.28.0",
    "xlsx": "^0.18.5"
  }
}
